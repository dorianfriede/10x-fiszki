---
import Layout from "@/layouts/Layout.astro";
import DeleteAccountDialog from "@/components/account/DeleteAccountDialog";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
---

<Layout title="Account settings">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Account settings
      </h1>

      <p class="mb-2 text-sm text-blue-100/60">Signed in as</p>
      <p class="mb-6 font-semibold text-white">{user?.email}</p>

      <div class="rounded-xl border border-red-500/30 bg-red-900/10 p-4">
        <h2 class="mb-1 text-sm font-semibold text-red-300">Danger zone</h2>
        <p class="mb-4 text-sm text-blue-100/60">
          Deleting your account removes it and all your decks and cards after a 30-day window.
        </p>
        <DeleteAccountDialog email={user?.email ?? ""} serverError={error} client:load />
      </div>

      <a href="/dashboard" class="mt-6 inline-block text-sm text-blue-200 transition hover:text-blue-100">
        ← Dashboard
      </a>
    </div>
  </div>
</Layout>
