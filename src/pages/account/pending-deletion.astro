---
import Layout from "@/layouts/Layout.astro";
import CancelDeletionDialog from "@/components/account/CancelDeletionDialog";

const { pendingDeletionRequestedAt } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const requestedAt = pendingDeletionRequestedAt ? new Date(pendingDeletionRequestedAt) : null;
const daysRemaining = requestedAt
  ? Math.max(0, 30 - Math.floor((Date.now() - requestedAt.getTime()) / 86_400_000))
  : null;
---

<Layout title="Account pending deletion">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Account deletion pending
      </h1>

      {
        requestedAt && (
          <p class="mb-2 text-blue-100/80">
            Requested on <span class="font-semibold text-white">{requestedAt.toLocaleDateString()}</span>
          </p>
        )
      }

      {
        daysRemaining !== null && (
          <p class="mb-6 text-blue-100/80">
            <span class="font-semibold text-white">{daysRemaining}</span> days remaining before permanent deletion
          </p>
        )
      }

      <p class="mb-6 text-sm text-blue-100/60">
        Your account and data are locked while this request is pending. Cancel below to restore full access.
      </p>

      <CancelDeletionDialog serverError={error} client:load />

      <form method="POST" action="/api/auth/signout" class="mt-3">
        <button
          type="submit"
          class="w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
