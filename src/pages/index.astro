---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Sparkles } from "lucide-react";

const { user } = Astro.locals;
const ctaClass = buttonVariants({ variant: "secondary" });
---

<Layout title="10xFiszki">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <Sparkles className="mx-auto mb-4 size-10 text-purple-300" />
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        10xFiszki
      </h1>
      <p class="mb-8 text-sm text-blue-100/70">
        Paste your notes and let AI turn them into flashcards in seconds — no manual card-writing required.
      </p>
      <div class="flex flex-col items-center gap-3">
        {
          user ? (
            <a href="/dashboard" class:list={[ctaClass]}>
              Go to dashboard
            </a>
          ) : (
            <>
              <a href="/auth/signin" class:list={[ctaClass]}>
                Sign in
              </a>
              <a href="/auth/signup" class:list={[ctaClass]}>
                Sign up
              </a>
            </>
          )
        }
      </div>
    </div>
  </div>
</Layout>
