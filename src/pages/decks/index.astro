---
import Layout from "@/layouts/Layout.astro";
import CreateDeckForm from "@/components/decks/CreateDeckForm";
import { createClient } from "@/lib/supabase";
import { buttonVariants } from "@/components/ui/button";
import { CircleAlert } from "lucide-react";

const error = Astro.url.searchParams.get("error");
const actionLinkClass = buttonVariants({ variant: "secondary", size: "sm" });
const deleteActionClass = buttonVariants({ variant: "destructive", size: "sm" });

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: decks, error: decksError } = supabase
  ? await supabase.from("decks").select("id, name, created_at").order("created_at", { ascending: false })
  : { data: null, error: null };
---

<Layout title="Decks">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Decks
      </h1>

      <div class="mb-8 rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <CreateDeckForm serverError={error} client:load />
      </div>

      {
        decksError ? (
          <p class="flex items-center justify-center gap-1 text-sm text-red-300">
            <CircleAlert className="size-4 shrink-0" />
            Couldn't load your decks. Please try refreshing the page.
          </p>
        ) : decks && decks.length > 0 ? (
          <ul class="space-y-2">
            {decks.map((deck) => (
              <li class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white">
                <span>{deck.name}</span>
                <div class="flex flex-wrap items-center gap-2">
                  <a href={`/decks/${deck.id}`} class:list={[actionLinkClass]}>
                    View cards
                  </a>
                  <a href={`/decks/${deck.id}/generate`} class:list={[actionLinkClass]}>
                    Generate cards
                  </a>
                  <a href={`/decks/${deck.id}/cards/new`} class:list={[actionLinkClass]}>
                    Add card
                  </a>
                  <a href={`/decks/${deck.id}/review`} class:list={[actionLinkClass]}>
                    Review
                  </a>
                  <form
                    method="POST"
                    action={`/api/decks/${deck.id}/delete`}
                    class="delete-deck-form"
                    data-deck-name={deck.name}
                  >
                    <button type="submit" class:list={[deleteActionClass]}>
                      Delete
                    </button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-center text-blue-100/60">You don't have any decks yet. Create one above.</p>
        )
      }
    </div>
  </div>

  <dialog
    id="delete-confirm-dialog"
    class="fixed top-1/2 left-1/2 m-0 w-full max-w-sm -translate-x-1/2 -translate-y-1/2 rounded-2xl border border-white/10 bg-slate-900/95 p-6 text-white backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  >
    <p class="mb-6 text-blue-100/80">
      Delete <span id="delete-confirm-deck-name" class="font-semibold text-white"></span>? This cannot be undone.
    </p>
    <div class="flex justify-end gap-3">
      <button
        type="button"
        id="delete-confirm-cancel"
        class="focus-visible:ring-ring/50 inline-flex h-9 cursor-pointer items-center justify-center rounded-md px-4 py-2 text-sm font-medium text-white transition-colors duration-150 outline-none hover:bg-white/10 focus-visible:ring-[3px]"
      >
        Cancel
      </button>
      <button
        type="button"
        id="delete-confirm-submit"
        class="inline-flex h-9 cursor-pointer items-center justify-center rounded-md border border-red-500/40 bg-red-600/15 px-4 py-2 text-sm font-medium text-red-100 shadow-xs transition-colors duration-150 outline-none hover:bg-red-600/25 focus-visible:ring-[3px] focus-visible:ring-red-500/20"
      >
        Delete
      </button>
    </div>
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#delete-confirm-dialog");
  const deckNameEl = document.querySelector("#delete-confirm-deck-name");
  const cancelButton = document.querySelector("#delete-confirm-cancel");
  const confirmButton = document.querySelector("#delete-confirm-submit");

  let pendingForm: HTMLFormElement | null = null;

  document.querySelectorAll<HTMLFormElement>(".delete-deck-form").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      pendingForm = form;
      if (deckNameEl) {
        deckNameEl.textContent = form.dataset.deckName ?? "this deck";
      }
      dialog?.showModal();
    });
  });

  cancelButton?.addEventListener("click", () => {
    pendingForm = null;
    dialog?.close();
  });

  confirmButton?.addEventListener("click", () => {
    dialog?.close();
    pendingForm?.submit();
    pendingForm = null;
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      pendingForm = null;
      dialog.close();
    }
  });

  dialog?.addEventListener("cancel", () => {
    pendingForm = null;
  });
</script>
