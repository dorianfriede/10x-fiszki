---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Mail } from "lucide-react";

const linkClass = buttonVariants({ variant: "secondary" });
---

<Layout title="Check your email">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <Mail className="mx-auto mb-4 size-10 text-purple-300" />
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Check your email
      </h1>
      <p class="mb-6 text-blue-100/80">
        We've sent a confirmation link to your email address. Click it to activate your account.
      </p>
      <a href="/auth/signin" class:list={[linkClass]}>Back to sign in</a>
    </div>
  </div>
</Layout>
