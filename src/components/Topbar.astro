---
import { Home, LayoutDashboard, Layers, LogOut, LogIn, UserPlus } from "lucide-react";

const { user } = Astro.locals;
const pathname = Astro.url.pathname;

function isActive(path: string) {
  return pathname === path || pathname.startsWith(`${path}/`);
}

const navLinkBase = "flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors";
const navLinkInactive = "text-purple-300 hover:bg-white/10 hover:text-purple-100";
const navLinkActive = "bg-white/10 text-white";
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <div class="flex items-center gap-1">
          <a href="/" class:list={[navLinkBase, isActive("/") ? navLinkActive : navLinkInactive]}>
            <Home className="size-4" />
            Home
          </a>
          <a href="/dashboard" class:list={[navLinkBase, isActive("/dashboard") ? navLinkActive : navLinkInactive]}>
            <LayoutDashboard className="size-4" />
            Dashboard
          </a>
          <a href="/decks" class:list={[navLinkBase, isActive("/decks") ? navLinkActive : navLinkInactive]}>
            <Layers className="size-4" />
            Decks
          </a>
          <form method="POST" action="/api/auth/signout" class="ml-1 border-l border-white/10 pl-2">
            <button
              type="submit"
              class="inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-md px-3 text-sm font-medium text-purple-300 transition-colors hover:bg-white/10 hover:text-purple-100"
            >
              <LogOut className="size-4" />
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex items-center gap-1">
          <a href="/auth/signin" class:list={[navLinkBase, isActive("/auth/signin") ? navLinkActive : navLinkInactive]}>
            <LogIn className="size-4" />
            Sign in
          </a>
          <a href="/auth/signup" class:list={[navLinkBase, isActive("/auth/signup") ? navLinkActive : navLinkInactive]}>
            <UserPlus className="size-4" />
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
